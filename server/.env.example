# KnowHow 后端配置（本地/服务器用，勿提交）
# 复制为 .env 并填写真实值。.env 已被 .gitignore 忽略。

PORT=3000

# DeepSeek API Key（在 platform.deepseek.com 创建，以 sk- 开头）
# ⚠️ 请使用新 Key —— 旧的已随公开仓库泄露，需在 DeepSeek 后台吊销
DEEPSEEK_API_KEY=sk-你的新key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 会话有效期（毫秒），默认 30 天
SESSION_TTL_MS=2592000000
